user_ids = [1, 2, 3, 4, 5]

def find_in_list(user_ids, target):
    for n in user_ids:
        if n == target:
            return True
    return False

user_dict = {1: "Alice", 2: "Bob", 3: "Cara", 4: "Dan", 5: "Eve"}

def find_in_dict(user_dict, target):
    return target in user_dict

list_result = find_in_list(user_ids, 2)
dict_result = find_in_dict(user_dict, 3)

print(list_result)
print(dict_result)
